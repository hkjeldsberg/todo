// Generates supabase/seed/glossary.sql (10 starter words) from src/content/glossary-seed.json.
// Run from app/, after migration 0010:   npm run glossary:seed
// Idempotent: words already in the glossary (same spanish_key) are left alone.
import { writeFileSync } from "node:fs";
import seed from "../src/content/glossary-seed.json";
import { spanishKey } from "../src/features/glossary/text";

const OWNER = "00000000-0000-0000-0000-000000000001";
const q = (v: string | null) => (v == null ? "null" : `'${v.replaceAll("'", "''")}'`);

const lines = [
  "-- GENERATED by scripts/glossary-seed-sql.mts from src/content/glossary-seed.json. Do not edit by hand.",
  "-- Ten starter words for the Glosario. Re-running inserts nothing new.",
  "begin;",
  "",
];
const themes = [...new Set(seed.words.flatMap((w) => w.themes))];
lines.push(
  `insert into todo.glossary_themes (user_id, name) values ${themes.map((t) => `('${OWNER}', ${q(t)})`).join(", ")}`,
  "  on conflict (user_id, name) do nothing;",
  "",
);
for (const w of seed.words) {
  const key = spanishKey(w.spanish);
  lines.push(
    "insert into todo.glossary_words (user_id, spanish, spanish_key, english, norwegian, pos, gender, my_guess, guess_verdict, guess_note, examples, status, source)",
    `  values ('${OWNER}', ${[w.spanish, key, w.english, w.norwegian, w.pos, w.gender, w.my_guess, w.guess_verdict, w.guess_note].map(q).join(", ")}, ${q(JSON.stringify(w.examples))}::jsonb, 'checked', 'import')`,
    "  on conflict (user_id, spanish_key) do nothing;",
    "insert into todo.glossary_word_themes (word_id, theme_id)",
    `  select w.id, t.id from todo.glossary_words w join todo.glossary_themes t on t.user_id = w.user_id and t.name in (${w.themes.map(q).join(", ")})`,
    `  where w.user_id = '${OWNER}' and w.spanish_key = ${q(key)}`,
    "  on conflict do nothing;",
  );
}
lines.push("", "commit;", "");
writeFileSync(new URL("../supabase/seed/glossary.sql", import.meta.url), lines.join("\n"));
console.log(`glossary.sql: ${seed.words.length} words, ${themes.length} themes`);
