// One-off: my notebook words (glossary/glossary_v2.csv) → supabase/seed/glossary_notes.sql,
// to run in the Supabase SQL editor after migration 0010:
//   npx tsx scripts/glossary-notes-sql.mts [glossary/glossary_v2.csv]
// The SQL first removes the starter test words (src/content/glossary-seed.json, inserted by the
// old seed/glossary.sql) and their themes, then inserts every notebook word as unchecked;
// `npm run glossary:enrich` checks them afterwards. A word written down more than once is
// inserted once, on its first date, with the translations combined. Safe to re-run.
import { readFileSync, writeFileSync } from "node:fs";
import starter from "../src/content/glossary-seed.json";
import { dateToTimestamp } from "../src/features/glossary/dates";
import { fold, spanishKey } from "../src/features/glossary/text";
import { parseCsv, validateRows, type ImportRow } from "./glossary-csv.mjs";
import { OWNER } from "./glossary-db.mjs";

const SRC = process.argv[2] ?? "glossary/glossary_v2.csv";
const OUT = "supabase/seed/glossary_notes.sql";

const { ok, bad, warnings } = validateRows(parseCsv(readFileSync(SRC, "utf8")));
if (bad.length) {
  for (const b of bad) console.error(`  bad line ${b.line}: ${b.message}`);
  process.exit(1);
}
for (const w of warnings) console.warn(`  warn line ${w.line}: ${w.message}`);

/** "a / b" + "b / c" → "a / b / c" (case-insensitive, accents ignored). */
function combine(...values: (string | null)[]): string {
  const parts: string[] = [];
  for (const value of values) {
    for (const part of (value ?? "").split("/").map((p) => p.trim()).filter(Boolean)) {
      if (!parts.some((p) => fold(p) === fold(part))) parts.push(part);
    }
  }
  return parts.join(" / ");
}

const merged = new Map<string, ImportRow & { lines: number[] }>();
for (const row of ok) {
  const key = spanishKey(row.spanish);
  const first = merged.get(key);
  if (!first) {
    merged.set(key, { ...row, lines: [row.line] });
    continue;
  }
  first.english = combine(first.english, row.english);
  first.norwegian = combine(first.norwegian, row.norwegian) || null;
  first.lines.push(row.line);
}

const q = (v: string | null) => (v == null || v === "" ? "null" : `'${v.replaceAll("'", "''")}'`);
const lines = [
  `-- GENERATED by scripts/glossary-notes-sql.mts from ${SRC}. Do not edit by hand.`,
  `-- ${ok.length} notebook rows → ${merged.size} words (repeats merged). Run after 0010. Safe to re-run.`,
  "begin;",
  "",
  "-- 1. Remove the starter test words from the old seed/glossary.sql, matched on word + its seeded first",
  "--    example sentence (so a notebook word with the same spelling is never touched), then any theme no",
  "--    word uses any more. Deleting a word also removes its Repaso card (trigger).",
  "delete from todo.glossary_words",
  `where user_id = '${OWNER}' and (spanish_key, examples->0->>'es') in (`,
  starter.words.map((w) => `  (${q(spanishKey(w.spanish))}, ${q(w.examples[0].es)})`).join(",\n"),
  ");",
  "delete from todo.glossary_themes t",
  `where t.user_id = '${OWNER}' and not exists (select 1 from todo.glossary_word_themes l where l.theme_id = t.id);`,
  "",
  "-- 2. My notebook words: unchecked, so `npm run glossary:enrich` (or the Glosario page) checks them.",
  "--    english is required: Norwegian-only words show their Norwegian until checked.",
  "insert into todo.glossary_words (user_id, spanish, spanish_key, english, norwegian, my_guess, status, source, created_at) values",
];
const values = [...merged.entries()].map(([key, w]) => {
  const english = w.english || w.norwegian!;
  return `  ('${OWNER}', ${q(w.spanish)}, ${q(key)}, ${q(english)}, ${q(w.norwegian)}, ${q(english)}, 'unchecked', 'import', '${dateToTimestamp(w.date ?? "2026-10-09")}')`;
});
lines.push(values.join(",\n"), "on conflict (user_id, spanish_key) do nothing;", "", "commit;", "");
writeFileSync(OUT, lines.join("\n"));

const repeats = [...merged.values()].filter((w) => w.lines.length > 1);
console.log(`Wrote ${OUT}: ${merged.size} words from ${ok.length} rows (${repeats.length} written down more than once)`);
for (const w of repeats) console.log(`  ${w.spanish}: ${w.english || "—"} | ${w.norwegian ?? "—"}  (lines ${w.lines.join(", ")})`);
